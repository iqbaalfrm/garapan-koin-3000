# Supabase PostgreSQL Connection String
# Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Nodejs)
# Contoh: postgres://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.your-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
